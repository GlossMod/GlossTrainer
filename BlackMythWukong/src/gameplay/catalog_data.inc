    {8488, "雾里云·云里雾", "精魄", "先化身雾里云，高举香把，甩打对手；再唤出云里雾放出三道金光，扫射对手", 13},
    {8492, "九叶灵芝精", "精魄", "化身九叶灵芝精，戴上地灵伞盖，此时可自由行动，每行处遍生灵芝。小灵芝炸开，对周遭对手造成毒伤", 13},
    {8511, "广谋", "精魄", "化身广谋，唤出毒蛇，向对手喷吐毒液，造成毒伤。待毒液喷尽，众蛇自行退走", 13},
    {8513, "幽魂", "精魄", "化身幽魂，志心朝礼，以铜头铁脑磕在对手身上，造成大量伤害", 13},
    {8515, "百目真人", "精魄", "化身百目真人，立下巫杖，杖头毒蟾双目放光。红光笼罩处，增加攻击；一定时间后，法杖自然幻灭", 13},
    {8517, "虎伥", "精魄", "化身虎伥，一瞬欺身，执刀劈杀对手，造成单次伤害", 13},
    {8520, "不空", "精魄", "化身不空，拂袖后撤，摇身幻成一道虚影，微微荡荡，令对手扑打不着", 13},
    {8522, "无量蝠", "精魄", "化身无量蝠，就地腾飞，躲开对手攻击，朝其扇出两股如刀霜风，造成寒冻伤害；若寒冻异常积满，还可将其冻在原地", 13},
    {8524, "不净", "精魄", "化身不净，满轮戒铲，左右挥砍，连攻对手数下，扫净诸邪", 13},
    {8525, "不白", "精魄", "化身不白，旋身翻腾，一瞬欺身，暴长身上尖刺，戳击对手", 13},
    {8526, "不能", "精魄", "化身不能，施展拳脚，不同的轻棍衔接化身技，将打出不同的招式", 13},
    {8527, "虫总兵", "精魄", "化身虫总兵，旋舞双刀，劈砍对手。旋起的刀风可刮伤周遭其余对手，造成一次范围伤害", 13},
    {8531, "百足虫", "精魄", "化身百足虫，将身一蜷，缩成巨球，冲撞周遭对手", 13},
    {8532, "兴烘掀·掀烘兴", "精魄", "化身兴烘掀、掀烘兴，合体并作铁球，弹入高空，砸将下来，如此三番连续击打对手", 13},
    {8533, "石父", "精魄", "化身石父，发出两声咆哮，震伤周遭的对手", 13},
    {8536, "燧统领", "精魄", "化身黑色坚石，若此时对手打来，可转震对手的攻击", 13},
    {8537, "燧先锋", "精魄", "化身燧先锋，以石拳连续捶打对手。每次捶打，对手都会积累火焚异常，若对手被点燃，还将造成持续伤害", 13},
    {8538, "琴螂仙", "精魄", "化身琴螂仙，朝对手用虫尾喷洒脓毒，秽物喷涌之处，形成小毒池，沾染的对手将积累毒伤", 13},
    {8539, "火灵元母", "精魄", "化身火灵元母，唤出火灵童子协助御敌。火灵童子喷吐烈焰，灼烧周遭的群怪", 13},
    {8540, "老人参精", "精魄", "化身老人参精，以根生根，唤出小人参精扑打对手", 13},
    {8541, "蘑女", "精魄", "化身蘑女，撑开菌伞，飘荡空中，抛出孢子。落地时砸在对手身上，孢子飞射而下，追踪并打在对手身上；打中对手的孢子可飞回己身恢复生命", 13},
    {8562, "疯虎", "精魄", "化身疯虎，竭力怒喝咆哮，威震周遭对手，造成前方范围伤害", 13},
    {8563, "沙二郎", "精魄", "化身沙二郎，跃舞金瓜锤，朝对手劈头就打，可将对手打退至一旁", 13},
    {8570, "地狼", "精魄", "化身地狼，撒野放刁，带起砂石直冲对手，顶其一个趔趄", 13},
    {8588, "雾里云·云里雾", "精魄", "先化身雾里云，高举香把，甩打对手；再唤出云里雾放出三道金光，扫射对手", 13},
    {8592, "九叶灵芝精", "精魄", "化身九叶灵芝精，戴上地灵伞盖，此时可自由行动，每行处遍生灵芝。小灵芝炸开，对周遭对手造成毒伤", 13},
    {8014, "鼠司空", "精魄", "化身鼠司空，举杖跃起，从杖顶发出电光冲射对手，造成雷蛰伤害", 13},
    {8028, "儡蜱士", "精魄", "化身儡蜱士，拽杖鸣叫，唤出小石蛛扑咬对手。石蛛亡命，体内毒液爆裂而出，对周遭形成毒伤", 13},
    {8029, "青冉冉", "精魄", "化身树木，吸收天地精华，持续恢复血量，若在水中，增强恢复效果", 13},
    {8030, "蝎太子", "精魄", "化身蝎妖，倒甩蝎尾，扎穿对手，在地上注入毒液，造成小范围毒伤，若对手此时在毒伤范围内，受到的伤害最多", 13},
    {8034, "地罗刹", "精魄", "化身地罗刹，挺重盾挥砸地面，伤害周遭对手，其后立下重盾，用于抵挡攻击", 13},
    {8035, "鳖宝", "精魄", "化身鳖宝，倒骑锤上，引燃锤中火药，冲天而上，落地时借力砸在对手身上，好教他断筋碎骨，爬不起身来", 13},
    {8042, "菇男", "精魄", "化身菇男，掣宝杖，转似车轮，冲撞对手及周遭群怪", 13},
    {8061, "狼刺客", "精魄", "化身狼刺客，飞起刀去，追魂索命，痛斩远处的对手", 13},
    {8064, "鼠禁卫", "精魄", "化身鼠禁卫，绕对手腾挪不定，乘其不备，剐下周遭对手几刀肉来", 13},
    {8065, "骨悚然", "精魄", "化身骨悚然，以虎神盾抵御攻击，喝退对手，其后连续冲撞，以盾牌砸击地面，震荡周遭群怪", 13},
    {8066, "狸侍长", "精魄", "化身狸侍长，抛舞双刀，朝对手当胸丢出，若是命中，两下里叫他尝尽剜心之苦", 13},
    {8067, "疾蝠", "精魄", "化身疾蝠，抖开翅，舞起风沙碎石，朝对手扑面打去", 13},
    {8068, "石双双", "精魄", "化身石双双，跳起双脚，飞蹬在对手胸口，若未能踢中，亦可砸在地面时，震伤周遭对手", 13},
    {8069, "鼠弩手", "精魄", "化身鼠弩手，踏弩搭箭，连射数次，造成多次伤害", 13},
    {8071, "隼居士", "精魄", "化身隼居士，扇一股阴风，风过之处，刮伤众人，造成多次寒冻伤害。接连吹中，还可将对手冻在原地", 13},
    {8072, "赤发鬼", "精魄", "化身赤发鬼，向对手射一支内劲之箭，势大力沉，可将其打退至一旁", 13},
    {8073, "戒刀僧", "精魄", "化身戒刀僧，轮着大刀，连转两圈，再朝着对手当头劈下", 13},
    {8074, "泥塑金刚", "精魄", "化身泥塑金刚，膝头喷吐火焰，大踏赸步，烈焰随步扭转，焚烧周遭对手", 13},
    {8075, "夜叉奴", "精魄", "化身夜叉奴，挥长戟直刺对手心胆，可将其打退至一旁", 13},
    {8076, "巡山鬼", "精魄", "化身巡山鬼，纵身跃起，朝对手乱劈而下，纵然打杀不了，也唬得他胆战心惊", 13},
    {8077, "鸦香客", "精魄", "化身鸦香客，挥香炉洒出一片寒冻香雾，站在寒雾中，敌我双方将持续积累寒冻状态", 13},
    {8078, "虫校尉", "精魄", "化身虫校尉，腾到空中，躲开对手的攻击，俯冲而下，劈砍落地处的对手", 13},
    {8079, "蜻蜓精", "精魄", "化身蜻蜓精，拉满弓，朝四周射出多支毒箭，攻击周遭的对手", 13},
    {8081, "傀蛛士", "精魄", "化身傀蛛士，用前螯反复搔挠对手", 13},
    {8083, "蛇捕头", "精魄", "化身蛇捕头，伸长头颈，仰天大啸，响震群怪", 13},
    {8084, "蛇司药", "精魄", "化身蛇司药，从药篓中掏出药汁，捽到地上，生成几滩毒池。对手踏入其中，积累毒伤状态", 13},
    {8085, "幽灯鬼", "精魄", "化身幽灯鬼，挥舞魂灯，拘唤鬼火，使其跟随追击对手", 13},
    {8086, "黑脸鬼", "精魄", "化身黑脸鬼，使一柄熔岩炼就的大刀，砸在地面上，引爆一团岩浆，伤害周遭对手", 13},
