    {8277, "鸦香客", "精魄", "化身鸦香客，挥香炉洒出一片寒冻香雾，站在寒雾中，敌我双方将持续积累寒冻状态", 13},
    {8278, "虫校尉", "精魄", "化身虫校尉，腾到空中，躲开对手的攻击，俯冲而下，劈砍落地处的对手", 13},
    {8279, "蜻蜓精", "精魄", "化身蜻蜓精，拉满弓，朝四周射出多支毒箭，攻击周遭的对手", 13},
