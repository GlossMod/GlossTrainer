    {16025, "虎筋绦子", "珍玩", "师父莫怕他，他是送衣服与我的。", 11},
    {16026, "仙胞石片", "珍玩", "盖自开辟以来，每受天真地秀，日精月华，感之既久，遂有灵通之意。", 11},
    {16001, "细磁茶盂", "珍玩", "胡桃银杏可传茶，椰子葡萄能做酒。", 11},
    {16002, "猫睛宝串", "珍玩", "珍奇玩好之物，不可使见贪婪奸伪之人。", 11},
    {16003, "玛瑙罐", "珍玩", "罗纹石上，护法威严；玛瑙滩前，木叉雄壮。", 11},
    {16004, "虎头牌", "珍玩", "小将不才，愿领五十个小妖校出去，把那甚么孙行者拿来凑吃。", 11},
    {16005, "砗磲佩", "珍玩", "久闻贤邻享乐瑶宫贝阙，必有多余神器。", 11},
    {16007, "琉璃舍利瓶", "珍玩", "原天命，则不惑祸福，治心术，则不妄喜怒。", 11},
    {16008, "风铎", "珍玩", "不好了，风响是那话儿来了！", 11},
    {16009, "雷榍", "珍玩", "又着雷部众神，以雷榍钉打，越发不能伤损一毫。", 11},
    {16010, "耐雪枝", "珍玩", "只修性，不修命，此是修行第一病。", 11},
    {16011, "白狐毫", "珍玩", "情由忆生，不忆故无情。", 11},
    {16015, "三清令", "珍玩", "局方而静，棋圆而动，以法天地，变化无穷。", 11},
    {16018, "错金银带钩", "珍玩", "起念断然有爱，留情必定生灾。", 11},
    {16019, "金钮", "珍玩", "酒极则乱，乐极则悲。", 11},
    {16020, "阳燧珠", "珍玩", "生生化化皆因火，火遍长空万物荣。", 11},
    {16027, "摩尼珠", "珍玩", "不论成仙成佛，须从个里安排。", 11},
    {16028, "博山炉", "珍玩", "一炉永寿香，几卷超生箓。", 11},
    {16029, "不求人", "珍玩", "空寂自然随变化，真如本性任为之。", 11},
    {16030, "吉祥灯", "珍玩", "祥光隐隐，不见甚么凶气纷纷。", 11},
    {16032, "兽与佛", "珍玩", "嗔嗔恨恨各无情，恶恶凶凶都有样。", 11},
    {16033, "铜佛坠", "珍玩", "他那里识得真假？这才是见像作佛。", 11},
    {16034, "雷火印", "珍玩", "飞升正法，雷火交加。", 11},
    {16035, "君子牌", "珍玩", "曾着卖糖君子哄，到今不信口甜人。", 11},
    {16036, "卵中骨", "珍玩", "恨小非君子，无毒不丈夫。", 11},
    {16037, "白贝腰链", "珍玩", "有心有意相争战，不定存亡不罢休。", 11},
    {16006, "金花玉萼", "珍玩", "这样好宝贝，若不换呵，诚为不是养家的儿子！", 11},
    {16012, "未来珠", "珍玩", "未来事，过去事，观如月镜；几家兴，几家败，鉴若神明。", 11},
    {16013, "金色鲤", "珍玩", "我每日送他一尾金色鲤，他就与我袖传一课，依方位，百下百着。", 11},
    {16014, "月玉兔", "珍玩", "得清凉，光皎洁，好向丹台赏明月。", 11},
    {16016, "定颜珠", "珍玩", "造化！造化！", 11},
    {16017, "日金乌", "珍玩", "月藏玉兔日藏乌，自有龟蛇相盘结。", 11},
    {16021, "水火篮", "珍玩", "天地间至利者，惟水火也。", 11},
    {16022, "辟水珠", "珍玩", "水不能溺，火不能焚。那些儿去不得？", 11},
    {16023, "琥珀念珠", "珍玩", "心地频频扫，尘情细细除。", 11},
    {16024, "仙箓", "珍玩", "贯通一姓身归本，只待荣迁仙箓名。", 11},
    {16031, "金棕衣", "珍玩", "纵然不死，也是个到老的破伤风！", 11},
    {16038, "石虎节", "珍玩", "抱虎枕蛟，事变叵测。", 11},
    {16039, "满堂红", "珍玩", "天灾苦困遭磨蛰，人事凄凉喜命长。", 11},
    {16040, "神铁碎片", "珍玩", "是一块神铁，能中何用？", 11},
    {19001, "辟火罩", "法宝", "使出辟火罩，一定时间内<{0}_KW>火焚不侵</>，缓慢获得<{0}_KW>棍势</>；对特殊环境和对手有奇效", 12},
    {19002, "定风珠", "法宝", "使出定风珠，一定时间内大大增加<{0}_KW>伤害减免</>，不受大风影响；对特殊对手有奇效", 12},
    {19004, "绣花针", "法宝", "使出绣花针，一定时间法宝将<{0}_KW>持续追踪并伤害</>对手；对特殊对手有奇效", 12},
    {19005, "芭蕉扇", "法宝", "使出芭蕉扇，可扇出<{0}_KW>飓风</>，席卷对手并将其<{0}_KW>抛至空中</>；对特殊对手有奇效", 12},
    {8512, "波波浪浪", "精魄", "雷蛙吁电，冰蛙嗳雾，毒蛙喷浊，火蛙呼焰，石蛙啸唳；放出此技，任化其一", 13},
    {8595, "冰蛙", "精魄", "", 13},
    {8596, "火蛙", "精魄", "", 13},
    {8597, "毒蛙", "精魄", "", 13},
    {8598, "雷蛙", "精魄", "", 13},
    {8599, "石蛙", "精魄", "", 13},
    {8011, "广谋", "精魄", "化身广谋，唤出毒蛇，向对手喷吐毒液，造成毒伤。待毒液喷尽，众蛇自行退走", 13},
    {8012, "波里个浪", "精魄", "化身波里个浪，张嘴弄舌，站在远处鞭抽对手，舌头虽软，却能伤人", 13},
    {8013, "幽魂", "精魄", "化身幽魂，志心朝礼，以铜头铁脑磕在对手身上，造成大量伤害", 13},
    {8015, "百目真人", "精魄", "化身百目真人，立下巫杖，杖头毒蟾双目放光。红光笼罩处，增加攻击；一定时间后，法杖自然幻灭", 13},
    {8017, "虎伥", "精魄", "化身虎伥，一瞬欺身，执刀劈杀对手，造成单次伤害", 13},
    {8020, "不空", "精魄", "化身不空，拂袖后撤，摇身幻成一道虚影，微微荡荡，令对手扑打不着", 13},
    {8022, "无量蝠", "精魄", "化身无量蝠，就地腾飞，躲开对手攻击，朝其扇出两股如刀霜风，造成寒冻伤害；若寒冻异常积满，还可将其冻在原地", 13},
    {8024, "不净", "精魄", "化身不净，满轮戒铲，左右挥砍，连攻对手数下，扫净诸邪", 13},
    {8025, "不白", "精魄", "化身不白，旋身翻腾，一瞬欺身，暴长身上尖刺，戳击对手", 13},
    {8026, "不能", "精魄", "化身不能，施展拳脚，不同的轻棍衔接化身技，将打出不同的招式", 13},
    {8027, "虫总兵", "精魄", "化身虫总兵，旋舞双刀，劈砍对手。旋起的刀风可刮伤周遭其余对手，造成一次范围伤害", 13},
    {8031, "百足虫", "精魄", "化身百足虫，将身一蜷，缩成巨球，冲撞周遭对手", 13},
    {8032, "兴烘掀·掀烘兴", "精魄", "化身兴烘掀、掀烘兴，合体并作铁球，弹入高空，砸将下来，如此三番连续击打对手", 13},
    {8033, "石父", "精魄", "化身石父，发出两声咆哮，震伤周遭的对手", 13},
    {8036, "燧统领", "精魄", "化身黑色坚石，若此时对手打来，可转震对手的攻击", 13},
    {8037, "燧先锋", "精魄", "化身燧先锋，以石拳连续捶打对手。每次捶打，对手都会积累火焚异常，若对手被点燃，还将造成持续伤害", 13},
    {8038, "琴螂仙", "精魄", "化身琴螂仙，朝对手用虫尾喷洒脓毒，秽物喷涌之处，形成小毒池，沾染的对手将积累毒伤", 13},
    {8039, "火灵元母", "精魄", "化身火灵元母，唤出火灵童子协助御敌。火灵童子喷吐烈焰，灼烧周遭的群怪", 13},
    {8040, "老人参精", "精魄", "化身老人参精，以根生根，唤出小人参精扑打对手", 13},
    {8041, "蘑女", "精魄", "化身蘑女，撑开菌伞，飘荡空中，抛出孢子。落地时砸在对手身上，孢子飞射而下，追踪并打在对手身上；打中对手的孢子可飞回己身恢复生命", 13},
    {8062, "疯虎", "精魄", "化身疯虎，竭力怒喝咆哮，威震周遭对手，造成前方范围伤害", 13},
    {8063, "沙二郎", "精魄", "化身沙二郎，跃舞金瓜锤，朝对手劈头就打，可将对手打退至一旁", 13},
    {8070, "地狼", "精魄", "化身地狼，撒野放刁，带起砂石直冲对手，顶其一个趔趄", 13},
    {8088, "雾里云·云里雾", "精魄", "先化身雾里云，高举香把，甩打对手；再唤出云里雾放出三道金光，扫射对手", 13},
    {8092, "九叶灵芝精", "精魄", "化身九叶灵芝精，戴上地灵伞盖，此时可自由行动，每行处遍生灵芝。小灵芝炸开，对周遭对手造成毒伤", 13},
    {8111, "广谋", "精魄", "化身广谋，唤出毒蛇，向对手喷吐毒液，造成毒伤。待毒液喷尽，众蛇自行退走", 13},
    {8112, "波里个浪", "精魄", "化身波里个浪，张嘴弄舌，站在远处鞭抽对手，舌头虽软，却能伤人", 13},
    {8113, "幽魂", "精魄", "化身幽魂，志心朝礼，以铜头铁脑磕在对手身上，造成大量伤害", 13},
    {8115, "百目真人", "精魄", "化身百目真人，立下巫杖，杖头毒蟾双目放光。红光笼罩处，增加攻击；一定时间后，法杖自然幻灭", 13},
    {8117, "虎伥", "精魄", "化身虎伥，一瞬欺身，执刀劈杀对手，造成单次伤害", 13},
    {8120, "不空", "精魄", "化身不空，拂袖后撤，摇身幻成一道虚影，微微荡荡，令对手扑打不着", 13},
    {8122, "无量蝠", "精魄", "化身无量蝠，就地腾飞，躲开对手攻击，朝其扇出两股如刀霜风，造成寒冻伤害；若寒冻异常积满，还可将其冻在原地", 13},
    {8124, "不净", "精魄", "化身不净，满轮戒铲，左右挥砍，连攻对手数下，扫净诸邪", 13},
    {8125, "不白", "精魄", "化身不白，旋身翻腾，一瞬欺身，暴长身上尖刺，戳击对手", 13},
    {8126, "不能", "精魄", "化身不能，施展拳脚，不同的轻棍衔接化身技，将打出不同的招式", 13},
    {8127, "虫总兵", "精魄", "化身虫总兵，旋舞双刀，劈砍对手。旋起的刀风可刮伤周遭其余对手，造成一次范围伤害", 13},
    {8131, "百足虫", "精魄", "化身百足虫，将身一蜷，缩成巨球，冲撞周遭对手", 13},
    {8132, "兴烘掀·掀烘兴", "精魄", "化身兴烘掀、掀烘兴，合体并作铁球，弹入高空，砸将下来，如此三番连续击打对手", 13},
    {8133, "石父", "精魄", "化身石父，发出两声咆哮，震伤周遭的对手", 13},
    {8136, "燧统领", "精魄", "化身黑色坚石，若此时对手打来，可转震对手的攻击", 13},
    {8137, "燧先锋", "精魄", "化身燧先锋，以石拳连续捶打对手。每次捶打，对手都会积累火焚异常，若对手被点燃，还将造成持续伤害", 13},
