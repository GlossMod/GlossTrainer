    {10933, "乌金臂鞲", "臂甲", "碗子铁盔火漆光，乌金铠甲亮辉煌。皂罗袍罩风兜袖，黑绿丝绦軃穗长。", 9},
    {11013, "金身护臂", "臂甲", "既在佛下会，都是有缘人。", 9},
    {11233, "藏风护臂", "臂甲", "避色如避仇，避风如避箭。", 9},
    {11313, "不净护釬", "臂甲", "他们都成佛，如何把我做个净坛使者？", 9},
    {11413, "羽士刺釬", "臂甲", "哥呵，只说经好取，西方路上，虫儿也欺负人哩！", 9},
    {11543, "百戏护手", "臂甲", "闹里挣钱，静处安身。", 9},
    {11603, "大力臂甲", "臂甲", "那魔王公然不惧。", 9},
    {11733, "青铜臂鞲", "臂甲", "待他灾愆满日，自有人救他。", 9},
    {11813, "玄铁硬手", "臂甲", "不知化铜的道人归何处，铸铜匠作那边存。", 9},
    {11923, "昆蚑刺手", "臂甲", "那魔是几年之魔，怪是几年之怪？", 9},
    {12003, "点翠飞龙釬", "臂甲", "好！好！好！", 9},
    {19993, "测试用手", "臂甲", "策划最爱", 9},
