    {5901, "气力", "法术", "精通疾奔与闪避，节约气力，交战时更灵巧机敏气力不竭方能战得痛快", 15},
    {5902, "体态", "法术", "体术门中，包罗筋骨，体态，闪避。修炼【体态】，可绵长气息，增大威势，不仅疾奔更远，势头也更狠。", 15},
    {5903, "闪避", "法术", "体术门中，包罗筋骨，体态，闪避。修炼【闪避】，可增快反应，灵活躯壳，更能游刃有余和及时地避开险招。", 15},
    {5904, "武艺", "法术", "精通轻棍与棍花，以棍护身，扎实武艺根基能守能战方便一路荡魔降妖", 15},
    {5905, "轻棍·连招", "法术", "轻棍门中，包罗起手，连招，终结。修炼【连招】，棍术更加行云流水，长短兼施，单双并用，威力惊人。", 15},
    {5906, "轻棍·终结", "法术", "轻棍门中，包罗起手，连招，终结。修炼【终结】，可增加最后一棍打出的威力，一套招式舞完，收束更快，势头更猛。", 15},
    {5907, "重棍·根基", "法术", "重棍门中，保罗三种棍术。修炼【根基】，可为门下三种棍法提供威能，更可悟得【撑棍】与【捅棍】的招数。", 15},
    {5908, "劈棍", "法术", "劈棍法的重棍，可边跑边蓄力，十分灵活可谓与对手进行周旋赌斗的首选招式", 15},
    {5909, "立棍", "法术", "立棍法的重棍，蓄力后能攀到棍头，伸缩自如躲避地面攻击的同时，还可进行大范围的反击可谓攻守兼备的首选招式", 15},
    {5910, "戳棍", "法术", "戳棍法的重棍，蓄力时须停留在原地能从较远处戳击敌人，对直冲而来的攻击尤为克制可谓稳中求胜的首选招式", 15},
    {5911, "御棍·棍势", "法术", "御棍门中，包罗棍势、转棍。修炼【棍势】，可让棍术更加凌厉，在见阵中越战越勇。", 15},
    {5912, "御棍·转棍", "法术", "御棍门中，包罗棍势、转棍。修炼【转棍】，可当下悟得新招式，舞棍似转轮，劲力缠绵不断，可弹开箭矢毒针。", 15},
    {5913, "体段修行", "法术", "精通肉身修行，固命归本，增强各项属性的上限肢强体壮正好逍遥行路", 15},
